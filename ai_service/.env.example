# AI Service Environment Variables

# AI API Keys (leave empty for trained-only mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Chatbot mode: auto | api_only | trained_only
CHATBOT_MODE=auto

# Server Backend
BACKEND_URL=http://localhost:5000

# PostgreSQL (optional)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/aura_archive
