# Server Environment Variables

# App
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aura_archive
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Email (SMTP - Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=AURA ARCHIVE <noreply@auraarchive.com>
ADMIN_EMAIL=admin@auraarchive.com

# AI Stylist (integrated — runs inside server)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CHATBOT_MODE=auto

# API Docs
# full   = show all routes, including protected/admin routes
# public = show public/demo-safe routes only
# off    = disable /docs and /openapi.json
API_DOCS_MODE=full

# Set to false to disable Swagger "Try it out" buttons
API_DOCS_TRY_IT_OUT=true

# Payments
# For real gateway callbacks, SERVER_URL/MOMO_*_URL/VNPAY_RETURN_URL must be public HTTPS.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api
MOMO_RETURN_URL=http://localhost:5000/api/v1/payments/momo/return
MOMO_IPN_URL=http://localhost:5000/api/v1/payments/momo/ipn

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/v1/payments/vnpay/return
VNPAY_IPN_URL=http://localhost:5000/api/v1/payments/vnpay/ipn
